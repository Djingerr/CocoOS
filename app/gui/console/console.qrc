        <file>sounds/nav_move_2.wav</file>
        <file>sounds/nav_move_3.wav</file>
        <file>sounds/nav_move_fast.wav</file>
        <file>sounds/network_cellular.wav</file>
        <file>sounds/network_quality_down.wav</file>
        <file>sounds/network_restored.wav</file>
        <file>sounds/network_unstable.wav</file>
        <file>sounds/notification.wav</file>
        <file>sounds/pairing_code.wav</file>
        <file>sounds/pairing_success.wav</file>
        <file>sounds/quit_confirm.wav</file>
