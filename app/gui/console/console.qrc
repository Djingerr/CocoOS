<!DOCTYPE RCC>
<!-- Ressources de la console embarquées par le build `embedded` seulement (app.pro) :
     le pack de sons CocoOS (docs/ui/cocoos/sounds/) ne doit pas peser sur Moonlight vanilla ;
     les motifs de vibration (docs/ui/cocoos/motion/haptics.json, lus par backend/haptics). -->
<RCC>
    <qresource prefix="/gui/console">
        <file>haptics.json</file>
        <file>images/grain.png</file>
        <file>shaders/Backdrop.frag.qsb</file>
        <file>shaders/Cover.frag.qsb</file>
        <file>shadows/cover.png</file>
        <file>shadows/coverSide.png</file>
        <file>sounds/amb_accueil.wav</file>
        <file>sounds/amb_appairage.wav</file>
        <file>sounds/amb_mise_a_jour.wav</file>
        <file>sounds/amb_repos.wav</file>
        <file>sounds/amb_veille.wav</file>
        <file>sounds/back.wav</file>
        <file>sounds/battery_critical.wav</file>
        <file>sounds/battery_low.wav</file>
        <file>sounds/boot.wav</file>
        <file>sounds/brightness_tick.wav</file>
        <file>sounds/capture.wav</file>
        <file>sounds/category_next.wav</file>
        <file>sounds/category_prev.wav</file>
        <file>sounds/charging_start.wav</file>
        <file>sounds/charging_stop.wav</file>
        <file>sounds/connecting_loop.wav</file>
        <file>sounds/controller_connected.wav</file>
        <file>sounds/controller_disconnected.wav</file>
        <file>sounds/deny.wav</file>
        <file>sounds/download_complete.wav</file>
        <file>sounds/favorite_add.wav</file>
        <file>sounds/favorite_remove.wav</file>
        <file>sounds/fiche_close.wav</file>
        <file>sounds/fiche_open.wav</file>
        <file>sounds/focus_tick.wav</file>
        <file>sounds/hold_done.wav</file>
        <file>sounds/hold_fill.wav</file>
        <file>sounds/host_online.wav</file>
        <file>sounds/host_unreachable.wav</file>
        <file>sounds/host_wake_send.wav</file>
        <file>sounds/idle_enter.wav</file>
        <file>sounds/idle_exit.wav</file>
        <file>sounds/ingame_menu_close.wav</file>
        <file>sounds/ingame_menu_open.wav</file>
