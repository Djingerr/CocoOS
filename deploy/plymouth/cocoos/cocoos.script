# Thème Plymouth de la console : du noir, rien d'autre. Le premier visuel est
# l'animation de démarrage de l'interface (le O de « OS » qui se trace,
# docs/boot-animation/), qui part elle aussi du noir. Aucun texte, aucune barre
# (CLAUDE.md §1 : rien de Linux à l'écran).
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Messages du démarrage : jamais affichés.
fun message_callback(text) {}
Plymouth.SetMessageFunction(message_callback);
