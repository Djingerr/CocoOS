# Thème Plymouth de la console : le logo centré sur noir, qui « respire » doucement
# tant que Linux démarre. Aucun texte, aucune barre (cf. CLAUDE.md §1 : rien de Linux).
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0);

tick = 0;
fun refresh_callback() {
    tick++;
    # Apparition en une seconde (50 images/s), puis respiration lente.
    if (tick < 50)
        logo.sprite.SetOpacity(tick / 50);
    else
        logo.sprite.SetOpacity(0.8 + 0.2 * Math.Cos((tick - 50) / 40));
}
Plymouth.SetRefreshFunction(refresh_callback);

# Messages du démarrage : jamais affichés.
fun message_callback(text) {}
Plymouth.SetMessageFunction(message_callback);
