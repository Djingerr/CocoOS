{
  "$comment": "Tokens de l'écran de veille CocoOS (version Premium, écrans 09-12). Unités : px de la grille de référence 1280x720. Échelle à l'exécution : s = min(largeur/1280, hauteur/720). letterSpacing est déjà converti en px (Qt font.letterSpacing est absolu). Si le projet a déjà un thème QML synchronisé depuis Figma, mapper ces valeurs dessus au lieu de dupliquer.",
  "reference": { "width": 1280, "height": 720 },

  "color": {
    "background": "#000000",
    "accent": "#F2802A",
    "textPrimary": "#F5F5F7",
    "textStatus": "rgba(245,245,247,0.78)",
    "textSecondary": "rgba(245,245,247,0.55)",
    "textUnit": "rgba(245,245,247,0.50)",
    "textHint": "rgba(245,245,247,0.50)",
    "textTertiary": "rgba(245,245,247,0.45)",
    "keyHintStroke": "rgba(245,245,247,0.45)",
    "batteryStroke": "rgba(245,245,247,0.45)",
    "track": "rgba(255,255,255,0.12)",
    "ringTrack": "rgba(255,255,255,0.16)",
    "ringTrackRest": "rgba(255,255,255,0.14)",
    "glassFill": "rgba(255,255,255,0.06)",
    "glassStroke": "rgba(255,255,255,0.10)",
    "hairline": "rgba(255,255,255,0.10)",
    "coverRing": "rgba(255,255,255,0.07)",
    "coverShadow": "rgba(0,0,0,0.60)",
    "vignetteInner": "rgba(0,0,0,0.30)",
    "vignetteOuter": "rgba(0,0,0,0.82)",
    "clockGradientTop": "#FFFFFF",
    "clockGradientBottom": "#A9A9AE"
  },

  "font": {
    "family": "Sora",
    "features": { "tnum": 1 },
    "$comment": "Sora possède la fonctionnalité OpenType tnum (vérifié). Qt >= 6.6 : font.features: { \"tnum\": 1 } sur tous les chiffres qui changent (heure, durées, %, ms).",
    "styles": {
      "eyebrow":       { "size": 12,  "weight": 600, "letterSpacing": 0.96,  "caps": true },
      "title":         { "size": 68,  "weight": 600, "letterSpacing": -3.06, "lineHeight": 1.05 },
      "meta":          { "size": 17,  "weight": 500, "letterSpacing": 0 },
      "bigNumber":     { "size": 72,  "weight": 600, "letterSpacing": -3.24, "lineHeight": 1.0 },
      "unit":          { "size": 28,  "weight": 500, "letterSpacing": 0 },
      "caption":       { "size": 15,  "weight": 500, "letterSpacing": 0 },
      "status":        { "size": 15,  "weight": 500, "letterSpacing": 0 },
      "downloadRow":   { "size": 14,  "weight": 500, "letterSpacing": 0 },
      "hint":          { "size": 14,  "weight": 500, "letterSpacing": 0 },
      "keyGlyph":      { "size": 11,  "weight": 600, "letterSpacing": 0 },
      "topClock":      { "size": 15,  "weight": 600, "letterSpacing": 0 },
      "coverLabel":    { "size": 11,  "weight": 500, "letterSpacing": 0.44 },
      "restDate":      { "size": 20,  "weight": 600, "letterSpacing": 0 },
      "restClock":     { "size": 176, "weight": 600, "letterSpacing": -9.68, "lineHeight": 1.0 },
      "capsuleTitle":  { "size": 15,  "weight": 600, "letterSpacing": 0 },
      "capsuleSub":    { "size": 12,  "weight": 500, "letterSpacing": 0 }
    }
  },

  "radius": { "cover": 12, "capsule": 38, "coverThumb": 5, "keyHint": 11, "liveDot": 3 },

  "effects": {
    "backdropBlurCssPx": 100,
    "backdropSaturation": 1.1,
    "backdropInset": -100,
    "coverShadow": { "x": 0, "y": 40, "blur": 90, "color": "rgba(0,0,0,0.60)" },
    "coverBrightness": { "placeholder": 0.62, "realCover": 0.92 },
    "coverLight": { "angleDeg": 135, "from": "rgba(255,255,255,0.10)", "toAt": 0.42 },
    "reflection": { "gap": 6, "startAlpha": 0.22, "fadeToZeroAt": 0.28 },
    "grain": { "texture": "assets/grain_256.png", "opacity": 0.07, "blend": "overlay", "fallbackNormalBlendOpacity": 0.035 },
    "restGlow": { "width": 1100, "height": 520, "centerX": 640, "top": 470, "stopAt": 0.65, "blurCssPx": 120, "opacity": 0.22 },
    "glassBlurCssPx": 40,
    "glassSaturation": 1.6
  },

  "motion": {
    "easing": {
      "appleOut": { "bezier": [0.32, 0.72, 0.0, 1.0], "qml": "Easing.Bezier, bezierCurve: [0.32, 0.72, 0.0, 1.0, 1, 1]" },
      "easeInOut": { "bezier": [0.42, 0.0, 0.58, 1.0], "qml": "Easing.InOutQuad (proche) ou Bezier [0.42,0,0.58,1,1,1]" },
      "linear": { "qml": "Easing.Linear" }
    },
    "entry": {
      "from": { "opacity": 0, "translateY": 18, "blurCssPx": 8 },
      "to": { "opacity": 1, "translateY": 0, "blurCssPx": 0 },
      "durationMs": 1000,
      "easing": "appleOut",
      "staggerMs": {
        "cover": { "delay": 0, "duration": 1200 },
        "eyebrow": 150,
        "title": 220,
        "meta": 290,
        "bigBlock": 400,
        "statusLine": 500,
        "topRightClock": 600,
        "downloadRow": 650,
        "keyHint": 1000,
        "restDate": 100,
        "restClock": { "delay": 200, "duration": 1200 },
        "restCapsule": { "delay": 450, "duration": 1100 }
      }
    },
    "loops": {
      "drift":       { "periodMs": 90000, "mode": "alternate", "easing": "easeInOut", "keyframes": [[0, 0, 0], [0.33, 6, -4], [0.66, -5, 5], [1.0, 4, 6]] },
      "backdropPan": { "periodMs": 60000, "mode": "alternate", "easing": "easeInOut", "from": { "scale": 1.25, "x": 0, "y": 0 }, "to": { "scale": 1.34, "x": -30, "y": 16 } },
      "coverTilt":   { "periodMs": 18000, "mode": "alternate", "easing": "easeInOut", "perspectivePx": 1400, "from": { "rotY": 9, "rotX": 1 }, "to": { "rotY": 3, "rotX": -1 } },
      "coverSheen":  { "periodMs": 11000, "easing": "easeInOut", "bandWidthRatio": 0.30, "bandHeightRatio": 1.40, "skewXDeg": -18, "peakAlpha": 0.13, "keyframes": [[0.0, -1.6], [0.55, -1.6], [0.85, 4.2], [1.0, 4.2]], "$comment": "x exprimé en multiples de la largeur de la bande" },
      "liveDot":     { "periodMs": 2400, "easing": "easeInOut", "opacity": [0.35, 1.0] },
      "downloadArrow": { "periodMs": 1800, "easing": "easeInOut", "translateY": [-1, 2] },
      "barSheen":    { "periodMs": 2400, "easing": "easeInOut", "bandWidthRatio": 0.30, "x": [-1.0, 3.5], "peakAlpha": 0.70 },
      "restGlow":    { "periodMs": 14000, "easing": "easeInOut", "opacityFactor": [0.7, 1.0], "scale": [1.0, 1.08] }
    },
    "oneShots": {
      "batteryRingDraw": { "delayMs": 600, "durationMs": 1600, "easing": "appleOut", "from": 0, "to": "battery.percent" },
      "progressUpdate":  { "durationMs": 1000, "easing": "linear", "$comment": "barre et anneau de téléchargement interpolent vers la nouvelle valeur" },
      "stateCrossfade":  { "durationMs": 600, "easing": "appleOut", "$comment": "changement d'état (ex. 09 -> 10) : fondu enchaîné puis rejoue l'entrée du nouvel état" },
      "exit":            { "durationMs": 320, "easing": "appleOut", "to": { "opacity": 0, "scale": 1.02 }, "$comment": "à toute entrée utilisateur, puis signal wakeRequested()" }
    }
  }
}
